# Atlas Keystone — variables d'environnement (copier vers apps/web/.env.local)
# Le client n'utilise QUE la clé anon (jamais service_role) — cf. CDC §2.3 / §14.

# --- Supabase (BaaS = le backend) ---
VITE_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
VITE_SUPABASE_ANON_KEY=YOUR-ANON-KEY

# --- service_role : UNIQUEMENT côté worker / Edge Functions, jamais exposé au client ---
# SUPABASE_SERVICE_ROLE_KEY=...

# --- PROPH3T (Ollama local-first) — worker / Edge only ---
# OLLAMA_BASE_URL=http://localhost:11434

# --- Pré-remplissage de l'écran de connexion (démo locale uniquement, ne pas committer de vraies valeurs) ---
VITE_DEMO_EMAIL=
VITE_DEMO_PASSWORD=
